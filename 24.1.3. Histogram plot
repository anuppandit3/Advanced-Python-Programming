import matplotlib.pyplot as plt
import pandas as pd

x = [1,1,1,2,2,2,2,3,3,4,4,5,5,5,5,6,6]

# Convert to DataFrame for easy handling
df = pd.Series(x)

# Replace 6 with 5 (merging 5 & 6)
df = df.replace(6, 5)

# Count Frequency
freq = df.value_counts().sort_index()

# Plot
plt.figure(figsize=(8,5))
plt.bar(freq.index, freq.values, width=0.6, edgecolor='black')

plt.xticks(freq.index)  # To show proper x-axis ticks

plt.show()
