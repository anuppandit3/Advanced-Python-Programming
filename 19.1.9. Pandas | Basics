import pandas as pd

# Creating DataFrames

# DataFrame 1 with Name, Age, and City
data1 = {'Name': ['John', 'Alice', 'Bob'],
         'Age': [25, 28, 22],
         'City': ['New York', 'London', 'Paris']}
df = pd.DataFrame(data1)  # This defines df
print("DataFrame:")
print(df)

# DataFrame 2 with Name and Salary
data2 = {'Name': ['Doraemon', 'Nobita', 'Shizuka'],
         'Salary': [10000, 5000, 7500]}
df2 = pd.DataFrame(data2)  # This defines df2
print("DataFrame:")
print(df2)

# Data filtering and selection
filtered_df = df[df['Age'] > 23]
print("Filtered DataFrame:")
print(filtered_df)

filtered_df2 = df2[df2['Salary'] > 5000]
print("Filtered DataFrame:")
print(filtered_df2)

# Basic Statistical Analysis
mean_age = df['Age'].mean()  # Mean Age
max_age = df['Age'].max()    # Maximum Age
min_age = df['Age'].min()    # Minimum Age
avg_salary = df2['Salary'].mean()  # Average Salary

# Print statistical results
print(f"Mean Age: {mean_age}")
print(f"Maximum Age: {max_age}")
print(f"Minimum Age: {min_age}")
print(f"Average Salary: {avg_salary}")



